{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "supabase/functions/_shared", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "supabase/functions/github-oauth", "supabase/functions/google-oauth", "supabase/functions/research-worker"]
}
